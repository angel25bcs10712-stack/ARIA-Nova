# ARIA Nova Environment Configuration
# Copy this file to .env and adjust as needed.

# Path to the local small language model directory or ONNX model artifact
ARIA_MODEL_PATH=./models/aria-slm

# Inference Backend: "auto" (detects QNN on Snapdragon, falls back to CPU), "cpu", or "qnn"
ARIA_BACKEND=auto

# Offline Mode: When true, all external cloud LLM connections are strictly disabled
ARIA_OFFLINE_MODE=true

# Logging Level: DEBUG, INFO, WARNING, ERROR
ARIA_LOG_LEVEL=INFO

# Optional device target override for testing (e.g., auto, cpu, qnn)
ARIA_DEVICE_OVERRIDE=auto
